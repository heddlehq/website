            "thread_ts": ""
          },
          "id": "sales",
          "label": "Tell sales",
          "position": {
            "x": 900,
            "y": 0
          },
          "type": "Slack: Send Message"
        },
        {
          "controls": {
            "credential": "",
            "range": "Leads!A:D",
            "rows": "[[\"{{lead.name}}\", \"{{lead.email}}\", \"{{result.company}}\", \"{{result.tier}}\"]]",
            "spreadsheet_id": "your-pipeline-spreadsheet-id"
          },
          "id": "pipeline",
          "label": "Add to the pipeline",
          "position": {
            "x": 900,
            "y": 150
          },
          "type": "Google Sheets: Add Rows"
        },
        {
          "controls": {
            "attachment": "",
            "attachment_name": "",
            "bcc": "",
            "cc": "",
            "credential": "",
            "format": "plain",
