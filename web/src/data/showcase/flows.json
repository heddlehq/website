      "id": "leads",
      "nodes": [
        {
          "controls": {
            "method": "POST",
            "path": "/leads"
          },
          "id": "form",
          "label": "Form sent",
          "position": {
            "x": 0,
            "y": 150
          },
          "type": "Webhook"
        },
        {
          "controls": {
            "code_elixir": "Map.put(context, \"lead\", context[\"body\"])",
            "code_python": "",
            "language": "elixir"
          },
          "id": "keep",
          "label": "Keep the lead",
          "position": {
            "x": 180,
            "y": 150
          },
          "type": "Evaluate Code"
        },
        {
          "controls": {
            "body": "",
            "headers": "{\"Accept\": \"application/vnd.github+json\"}",
            "method": "GET",
            "url": "https://api.github.com/orgs/{{lead.github_org}}"
          },
          "id": "lookup",
          "label": "Look up the company",
          "position": {
            "x": 360,
            "y": 150
          },
          "type": "HTTP Request"
        },
        {
          "controls": {
            "code_elixir": "tier =\n  cond do\n    result[\"followers\"] >= 1_000 -> \"hot\"\n    result[\"public_repos\"] >= 20 -> \"warm\"\n    true -> \"cold\"\n  end\n\nMap.put(context, \"result\", %{\n  \"company\" => result[\"name\"],\n  \"followers\" => result[\"followers\"],\n  \"tier\" => tier\n})",
            "code_python": "",
            "language": "elixir"
          },
          "id": "score",
          "label": "Score it",
          "position": {
            "x": 540,
            "y": 150
          },
          "type": "Evaluate Code"
        },
        {
          "controls": {
            "case_1": "hot",
            "case_2": "warm",
            "case_3": "",
            "case_4": "",
            "switch_value": "{{result.tier}}"
          },
          "id": "route",
          "label": "Route by tier",
          "position": {
            "x": 720,
            "y": 150
          },
          "type": "Switch"
        },
        {
          "controls": {
            "channel": "#sales",
            "credential": "",
