---
import Base from '../layouts/Base.astro';
import FlowFigure from './FlowFigure.astro';
import Mark from './Mark.astro';
import Typed from './Typed.astro';
import { installCommands, links, site, waitlistEndpoint } from '../config';
import benchmark from '../data/benchmark.json';
import crash from '../data/crash.json';
import slow from '../data/slow.json';
import type { Copy } from '../i18n/en';

interface Props {
  t: Copy;
}

const { t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const number = (value: number) => value.toLocaleString(t.lang);
const gigabytes = (megabytes: number) =>
  (megabytes / 1024).toLocaleString(t.lang, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
---

<Base t={t}>
  <a class="skip" href="#main">{t.skip}</a>

  <svg class="sr-only" aria-hidden="true">
    <filter id="struck">
      <feTurbulence type="fractalNoise" baseFrequency="0.7" numOctaves="2" seed="3" />
      <feDisplacementMap in="SourceGraphic" scale="0.9" />
    </filter>
  </svg>

  <header class="sheet masthead">
    <a class="brand" href={`${base}${t.path}`} aria-label={t.home}>
      <Mark />
      <span>{site.name}</span>
    </a>
    <nav aria-label={t.navLabel}>
      <a href="#what">{t.nav.what}</a>
      <a href="#early">{t.nav.early}</a>
      <a href={links.source} target="_blank" rel="noopener">{t.nav.source}</a>
      <a
        href={`${base}${t.switchTo.path}`}
        hreflang={t.switchTo.lang}
        lang={t.switchTo.lang}
        title={t.switchTo.title}>{t.switchTo.label}</a
      >
    </nav>
  </header>

  <main id="main" class="sheet">
    <section class="hero">
      <h1><Typed lines={t.hero.lines} accent={t.hero.accent} /></h1>
      <p class="lead">{t.hero.lead}</p>
      <p class="actions">
        <a href="#early">{t.hero.join}</a>
        <a href="#self-host">{t.hero.selfHost}</a>
      </p>
      <p class="entry">
        <strong lang="en">heddle</strong> <span class="ipa">/ˈhɛd.əl/</span>
        <em>{t.entry.kind}</em>
        {t.entry.text}
      </p>
    </section>

    <p class="break" aria-hidden="true">* * *</p>

    <section aria-labelledby="what">
      <h2 id="what" data-n="1.">{t.what.title}</h2>
      <p>{t.what.intro}</p>
      <FlowFigure t={t.figure} />
      <p>{t.what.after}</p>
    </section>

    <section aria-labelledby="today">
      <h2 id="today" data-n="2.">{t.today.title}</h2>
      <p class="claim">{t.today.claim} <span>{t.today.claimAccent}</span></p>
      <p class="lead">{t.today.lead}</p>
      <ul class="stamps" aria-label={t.today.stampsLabel}>
        {t.today.stamps.map((name) => <li>{name}</li>)}
      </ul>
      <dl class="stats" aria-label={t.today.statsLabel}>
        {
          t.today.stats.map(({ value, label }) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="features">
        {
          t.today.features.map(({ title, text }) => (
            <div>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          ))
        }
      </div>
      <p class="next">{t.today.nextLabel} <a href={links.board}>{t.today.nextLink}</a>.</p>
    </section>

    <section aria-labelledby="bench">
      <h2 id="bench" data-n="3.">{t.bench.title}</h2>
      <div class="tabs" role="tablist" aria-label={t.bench.tabsLabel} data-tabs>
        <button type="button" role="tab" id="tab-speed" aria-controls="panel-speed" aria-selected="true">
          {t.bench.tabs.speed}
        </button>
        <button type="button" role="tab" id="tab-slow" aria-controls="panel-slow" aria-selected="false" tabindex="-1">
          {t.bench.tabs.slow}
        </button>
        <button type="button" role="tab" id="tab-crash" aria-controls="panel-crash" aria-selected="false" tabindex="-1">
          {t.bench.tabs.crash}
        </button>
      </div>
      <div class="panel is-open" id="panel-speed" role="tabpanel" aria-labelledby="tab-speed">
        <p>{t.bench.why}</p>
        <p>{t.bench.result}</p>
        <p class="small">{t.bench.how}</p>
        <div class="bench" tabindex="0" role="region" aria-labelledby="bench">
          <table>
            <caption class="sr-only">{t.bench.caption}</caption>
            <thead>
              <tr>
                <th scope="col">{t.bench.tool}</th>
                <th scope="col">{t.bench.perSecond}</th>
                <th scope="col">{t.bench.oneRun}</th>
                <th scope="col">{t.bench.memory}</th>
                <th scope="col">{t.bench.disk}</th>
              </tr>
            </thead>
            <tbody>
              {
                benchmark.map((row) => (
                  <tr class:list={{ ours: row.tool === site.name }}>
                    <th scope="row">{row.tool}</th>
                    <td>
                      {number(row.completedPerSecond)}
                      {!row.finished && '*'}
                    </td>
                    <td>{number(Math.round(row.oneRunMs))} ms</td>
                    <td>{number(row.idleMemoryMb)} MB</td>
                    <td>{gigabytes(row.diskMb)} GB</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="small">{t.bench.star}</p>
      </div>
      <div class="panel" id="panel-slow" role="tabpanel" aria-labelledby="tab-slow">
        <p>{t.bench.slow.why}</p>
        <p>{t.bench.slow.result}</p>
        <p class="small">{t.bench.slow.how}</p>
        <div class="bench crash" tabindex="0" role="region" aria-label={t.bench.slow.caption}>
          <table>
            <caption class="sr-only">{t.bench.slow.caption}</caption>
            <thead>
              <tr>
                <th scope="col">{t.bench.tool}</th>
                <th scope="col">{t.bench.perSecond}</th>
              </tr>
            </thead>
            <tbody>
              {
                slow.map((row) => (
                  <tr class:list={{ ours: row.tool === site.name }}>
                    <th scope="row">{row.tool}</th>
                    <td>{number(row.completedPerSecond)}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="small">{t.bench.slow.limit}</p>
      </div>
      <div class="panel" id="panel-crash" role="tabpanel" aria-labelledby="tab-crash">
        <p>{t.bench.crash.why}</p>
        <p>{t.bench.crash.result}</p>
        <p class="small">{t.bench.crash.how}</p>
        <div class="bench crash" tabindex="0" role="region" aria-label={t.bench.crash.caption}>
          <table>
            <caption class="sr-only">{t.bench.crash.caption}</caption>
            <thead>
              <tr>
                <th scope="col">{t.bench.tool}</th>
                <th scope="col">{t.bench.crash.lost}</th>
                <th scope="col">{t.bench.crash.stuck}</th>
                <th scope="col">{t.bench.crash.repeated}</th>
              </tr>
            </thead>
            <tbody>
              {
                crash.map((row) => (
                  <tr class:list={{ ours: row.tool === site.name }}>
                    <th scope="row">
                      {row.tool}
                      {row.redis && '*'}
                    </th>
                    <td>{number(row.lost)}</td>
                    <td>{number(row.stuck)}</td>
                    <td>{number(row.repeated)}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="small">{t.bench.crash.star}</p>
        <p class="small">{t.bench.crash.rescue}</p>
      </div>
      <p class="actions"><a href={links.benchmark}>{t.bench.method}</a></p>
    </section>

    <section aria-labelledby="early">
      <h2 id="early" data-n="4.">{t.early.title}</h2>
      <p>{t.early.intro}</p>
      <form
        class="join"
        data-join
        data-endpoint={waitlistEndpoint}
        data-lang={t.lang}
        data-sending={t.early.sending}
        data-success={t.early.success}
        data-error={t.early.error}
      >
        <label for="email">{t.early.label}</label>
        <div class="join-row">
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder={t.early.placeholder}
          />
          <button type="submit">{t.early.submit}</button>
        </div>
        <input class="trap" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <p class="status" role="status" aria-live="polite"></p>
      </form>
      <p class="small">{t.early.consent}</p>
      <noscript><p class="small">{t.early.noscript} <a href={links.discord}>Discord</a>.</p></noscript>
    </section>

    <section aria-labelledby="self-host">
      <h2 id="self-host" data-n="5.">{t.selfHost.title}</h2>
      <p>{t.selfHost.intro}</p>
      {
        [
          { label: t.selfHost.unix, command: installCommands.unix },
          { label: t.selfHost.windows, command: installCommands.windows },
          { label: t.selfHost.treadle, command: installCommands.treadle },
          { label: t.selfHost.agent, command: t.selfHost.agentPrompt.replace('{guide}', links.install) },
        ].map(({ label, command }) => (
          <figure class="command">
            <figcaption>{label}</figcaption>
            <pre tabindex="0"><code>{command}</code></pre>
            <button type="button" hidden data-copy={command} data-done={t.selfHost.copied}>
              {t.selfHost.copy}
            </button>
          </figure>
        ))
      }
      <p>{t.selfHost.after}</p>
      <p class="small">{t.selfHost.safety}</p>
      <p class="actions"><a href={links.install}>{t.selfHost.guide}</a></p>
      <p class="small">
        {t.selfHost.tech} <a href={links.scaling}>{t.selfHost.scaling}</a>
        {t.selfHost.techEnd} <a href={links.api}>{t.selfHost.api}</a>
        {t.selfHost.techTail}
      </p>
    </section>

    <section aria-labelledby="open">
      <h2 id="open" data-n="6.">{t.open.title}</h2>
      <p>
        {t.open.a} <a href={links.roadmap}>{t.open.roadmap}</a>
        {t.open.b} <a href={links.discord}>Discord</a>.
        {t.open.c} <a href={links.contributing}>{t.open.contributing}</a>.
      </p>
    </section>
  </main>

  <footer class="sheet colophon">
    <p class="closing">{t.footer.closing}</p>
    <p>
      {site.name}
      {site.version}. <a href={links.license}>{t.footer.license}</a>.
    </p>
    <p class="folio" aria-hidden="true">- 1 -</p>
  </footer>
</Base>

<style>
  .masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-4) 0;
    font-family: var(--font-type);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    font-size: 1rem;
  }

  nav a {
    display: inline-block;
    padding-block: var(--space-2);
  }

  .hero {
    padding-block: clamp(4rem, 14vh, 8rem) var(--space-5);
  }

  h1 {
    font-family: var(--font-type);
    font-size: clamp(1.75rem, calc(9.4vw - 4px), 3.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0;
    filter: url('#struck');
  }

  .lead {
    margin-block-start: var(--space-4);
    font-size: 1.1875rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin-block-start: var(--space-4);
    font-family: var(--font-type);
    font-weight: 700;
  }

  section .actions {
    margin-block-start: var(--space-3);
  }

  .actions a {
    display: inline-block;
    padding-block: var(--space-2);
    text-decoration: none;
  }

  .entry {
    margin-block-start: var(--space-5);
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .entry strong {
    color: var(--ink);
    font-family: var(--font-type);
  }

  .ipa {
    font-family: Georgia, 'Times New Roman', serif;
  }

  .break {
    color: var(--ink-soft);
    font-family: var(--font-type);
    text-align: center;
  }

  section + section,
  .break + section {
    margin-block-start: var(--space-6);
  }

  h2 {
    position: relative;
    margin-block-end: var(--space-3);
    font-family: var(--font-type);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-transform: uppercase;
    text-underline-offset: 0.3em;
    scroll-margin-block-start: var(--space-4);
  }

  h2::before {
    content: attr(data-n) ' ';
    color: var(--ribbon);
    white-space: pre;
  }

  h3 {
    margin-block: var(--space-4) var(--space-2);
    font-family: var(--font-type);
    font-size: 1rem;
    font-weight: 700;
  }

  section p + p {
    margin-block-start: var(--space-3);
  }

  .command {
    margin: 1.25rem 0 0;
    position: relative;
  }

  .command figcaption {
    color: var(--ink-soft);
    font-family: var(--font-type);
    font-size: 0.875rem;
    margin-bottom: 0.25rem;
  }

  .command pre {
    background: var(--paper-deep);
    border: 1px solid var(--rule);
    font-family: var(--font-type);
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
    padding: 0.75rem;
  }

  .command button {
    background: none;
    border: 0;
    color: var(--ribbon);
    cursor: pointer;
    font-family: var(--font-type);
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0;
    position: absolute;
    right: 0;
    top: 0;
  }

  .command button:hover {
    text-decoration: underline;
  }

  .command + p {
    margin-block-start: var(--space-3);
  }

  .small {
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .claim {
    margin-block-start: var(--space-4);
    font-family: var(--font-type);
    font-size: clamp(1.75rem, calc(8vw - 4px), 3rem);
    font-weight: 700;
    line-height: 1.15;
    filter: url('#struck');
  }

  .claim span {
    display: block;
    color: var(--ribbon);
  }

  section .lead {
    margin-block-start: var(--space-3);
  }

  .stamps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .stamps li {
    padding: 0.125rem 0.625rem;
    border: 2px solid var(--ribbon);
    border-radius: 3px;
    color: var(--ribbon);
    font-family: var(--font-type);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    transform: rotate(-1.2deg);
  }

  .stamps li:nth-child(3n) {
    transform: rotate(0.9deg);
  }

  .stamps li:nth-child(4n + 1) {
    transform: rotate(0.4deg);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3) var(--space-3);
    margin-block-start: var(--space-5);
    padding-block: var(--space-3);
    border-block: 1px solid var(--ink);
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
  }

  .stats dd {
    font-family: var(--font-type);
    font-size: clamp(1.75rem, 7vw, 2.25rem);
    font-weight: 700;
    line-height: 1.1;
    white-space: nowrap;
  }

  .stats dt {
    color: var(--ink-soft);
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .features {
    display: grid;
    gap: var(--space-4);
    margin-block-start: var(--space-5);
  }

  .features h3 {
    margin-block: 0 var(--space-1);
    font-size: 1.1875rem;
    line-height: 1.25;
  }

  .features h3::before {
    content: '';
    display: block;
    width: 2rem;
    margin-block-end: var(--space-2);
    border-block-start: 3px solid var(--ribbon);
  }

  .features p {
    color: var(--ink-soft);
    font-size: 1rem;
  }

  .next {
    margin-block-start: var(--space-5);
    font-family: var(--font-type);
    font-weight: 700;
  }

  @media (min-width: 36rem) {
    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4) var(--space-5);
    }
  }

  table {
    width: 100%;
    margin-block: var(--space-4) var(--space-3);
    border-collapse: collapse;
  }

  thead th {
    border-block-end: 1px solid var(--ink);
    font-family: var(--font-type);
    font-size: 1rem;
  }

  th,
  td {
    padding: var(--space-2) var(--space-2) var(--space-2) 0;
    text-align: start;
    vertical-align: baseline;
  }

  tbody th {
    font-weight: 400;
  }

  td {
    width: 5.5ch;
    font-family: var(--font-type);
    font-weight: 700;
    white-space: nowrap;
  }

  thead th {
    vertical-align: bottom;
  }

  /* Wider than a phone, so the table scrolls and the page doesn't. */
  .bench {
    margin-block: var(--space-4) var(--space-3);
    overflow-x: auto;
  }

  .bench table {
    min-width: 34rem;
    margin: 0;
  }

  .bench td {
    width: auto;
    font-weight: 400;
  }

  .bench.crash table {
    min-width: 0;
  }

  .tabs {
    display: none;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin-block-end: var(--space-3);
  }

  :global(html.js) .tabs {
    display: flex;
  }

  .tabs button {
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-soft);
    cursor: pointer;
    font-family: var(--font-type);
    font-size: inherit;
    font-weight: 700;
  }

  .tabs button:hover,
  .tabs button[aria-selected='true'] {
    color: var(--ribbon);
  }

  :global(html.js) .panel:not(.is-open) {
    display: none;
  }

  .ours th,
  .ours td {
    color: var(--ribbon);
    font-weight: 700;
  }

  .join {
    margin-block: var(--space-3) var(--space-2);
  }

  label {
    display: block;
    margin-block-end: var(--space-1);
    font-family: var(--font-type);
    font-weight: 700;
  }

  .join-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    align-items: center;
  }

  input[type='email'] {
    flex: 1 1 16rem;
    min-width: 0;
    min-height: 2.75rem;
    padding: var(--space-1) 0;
    border: 0;
    border-block-end: 1px solid var(--ink);
    border-radius: 0;
    background: none;
    color: inherit;
    font-family: var(--font-type);
    font-size: 1.0625rem;
  }

  input[type='email']::placeholder {
    color: var(--ink-soft);
  }

  .join button {
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    font-family: var(--font-type);
    font-size: inherit;
    font-weight: 700;
  }

  .join button:hover {
    color: var(--ribbon);
  }

  .join button:disabled {
    color: var(--ink-soft);
    cursor: default;
  }

  .trap {
    position: absolute;
    inset-inline-start: -100vw;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .status {
    min-height: 1.65em;
    margin-block-start: var(--space-2);
    font-family: var(--font-type);
    font-weight: 700;
  }

  .colophon {
    margin-block-start: var(--space-6);
    padding-block-end: var(--space-4);
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .closing {
    margin-block-end: var(--space-4);
    color: var(--ink);
    font-family: var(--font-type);
    font-size: 1.125rem;
    font-weight: 700;
    text-align: center;
  }

  .folio {
    margin-block-start: var(--space-4);
    font-family: var(--font-type);
    text-align: center;
  }

  @media (min-width: 64rem) {
    h2::before {
      position: absolute;
      inset-inline-end: 100%;
      margin-inline-end: var(--space-3);
    }
  }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tabs] [role=tab]')];

  const openTab = (tab: HTMLButtonElement) => {
    for (const other of tabs) {
      const selected = other === tab;
      other.setAttribute('aria-selected', String(selected));
      other.tabIndex = selected ? 0 : -1;
      document.getElementById(other.getAttribute('aria-controls') ?? '')?.classList.toggle('is-open', selected);
    }
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => openTab(tab));
    tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      const step = event.key === 'ArrowRight' ? 1 : -1;
      const next = tabs[(index + step + tabs.length) % tabs.length];
      if (next) {
        openTab(next);
        next.focus();
      }
    });
  });

  // Hidden in the markup: without JavaScript or a clipboard it couldn't do anything.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    if (!navigator.clipboard) return;

    const label = button.textContent ?? '';
    button.hidden = false;

    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? '');
      button.textContent = button.dataset.done ?? label;
      setTimeout(() => (button.textContent = label), 2000);
    });
  });

  const form = document.querySelector<HTMLFormElement>('[data-join]');

  if (form) {
    const { endpoint = '', lang, sending, success, error } = form.dataset;
    const button = form.querySelector('button')!;
    const status = form.querySelector('.status')!;
    const label = button.textContent ?? '';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      button.disabled = true;
      button.textContent = sending ?? label;
      status.textContent = '';

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: data.get('email'),
            website: data.get('website'),
            lang,
          }),
        });
        if (!response.ok) throw new Error(String(response.status));
        form.querySelector('.join-row')?.remove();
        form.querySelector('label')?.remove();
        status.textContent = success ?? '';
      } catch {
        status.textContent = error ?? '';
        button.disabled = false;
        button.textContent = label;
      }
    });
  }
</script>
