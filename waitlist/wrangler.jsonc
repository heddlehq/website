{
  "name": "heddle-waitlist",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "heddle-waitlist",
      "database_id": "6ae4f2c4-0c14-4530-83c1-29e99f8a0dd5",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://heddlehq.github.io,http://localhost:4321"
  }
}
